<div class="container-v">
    <a href="/">Home</a>
    <h2>All Movies</h2>
    <ul>
        {{#each allMovies}}
        <div class="container-h">
            <li>{{this.title}}</li>
            <a href="/movies/{{this._id}}">See more</a>
            <a href="/movies/{{this._id}}/edit">Edit</a>
        </div>
        {{/each}}
    </ul>
</div>

