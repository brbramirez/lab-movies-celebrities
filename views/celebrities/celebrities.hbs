<div class="container-v">
    <a href="/">Home</a>

    <h2>All Celebrities</h2>

    <ul>
        {{#each allCelebrities}}
        <div class="container-h">
            <li>{{this.name}}</li>
            <a href="/celebrities/{{this._id}}">See details</a>
            <form action="/celebrities/{{this._id}}/delete" method="POST">
                <input class="submit" type="submit" value="Delete Celebrity" />
            </form>
            <a href="/celebrities/{{this._id}}/edit"> Edit Celebrity</a>
        </div>
        {{/each}}
    </ul>

</div>

